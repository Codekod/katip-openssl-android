# What is built. Only supported OpenSSL LTS lines (https://openssl-library.org/policies/releasestrat/).
OPENSSL_VERSION=3.5.9
# openssl-3.5.9.tar.gz, as published with the release.
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
# Primary key of OpenSSL's release signing certificate, the trust anchor named on
# https://openssl-library.org/source/ . The signature must be valid and made under this key.
OPENSSL_PGP_FINGERPRINT=B146647E45A7B33947AB226B2A2C87D161692D40
# The Android NDK used by React Native 0.88.
NDK_VERSION=27.1.12297006
# Lowest Android API level (React Native 0.88's minSdk).
ANDROID_API=24
# arm64-v8a: phones. x86_64: the emulator.
ABIS="arm64-v8a x86_64"
# Release time of OpenSSL 3.5.9 (2026-09-29T14:10Z): file times in the AAR and OpenSSL's build date.
SOURCE_DATE_EPOCH=1790690724
